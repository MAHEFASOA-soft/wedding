APP_ENV=prod
APP_SECRET=replace_with_a_secure_random_secret

DEFAULT_URI=https://your-backend.onrender.com
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://.*\.onrender\.com$|^https://.*\.yourdomain\.com$'

DATABASE_URL="postgresql://postgres:your_db_password@your_db_host:5432/your_db_name?serverVersion=16&charset=utf8"
